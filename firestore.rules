rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myId() { return request.auth.token.email.split('@')[0].split('[.]')[0]; }
    function admins() { return get(/databases/$(database)/documents/config/main).data.admins; }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(myId()))
        && !('deletedAt' in get(/databases/$(database)/documents/members/$(myId())).data && get(/databases/$(database)/documents/members/$(myId())).data.deletedAt != null);
    }
    function isDev() { return signedIn() && myId() == 'admin-adminski'; }
    function isAdmin() { return isMember() && (myId() == 'admin-adminski' || myId() in admins()); }

    // Konfiguration: Version/Salz/Admin-Liste sind nicht geheim (Anmeldung braucht sie vor dem Login)
    match /config/main {
      allow read: if true;
      allow create: if signedIn() && myId() == 'admin-adminski' && !exists(/databases/$(database)/documents/config/main);
      allow update, delete: if isAdmin();
    }
    // Geschäftspasswort (nur als Prüfwert, nur Admins lesen/schreiben)
    match /config/biz {
      allow read, write: if isAdmin() || (isDev() && !exists(/databases/$(database)/documents/config/biz));
    }
    match /config/prefs { allow read: if isMember(); allow write: if isAdmin(); }
    match /config/flags { allow read: if isMember(); allow write: if isDev(); }
    match /config/dev { allow read: if isMember(); allow write: if isDev(); }

    // Registrierung: Prüfwert des Geschäftspassworts wird serverseitig verglichen
    match /reg/{id} {
      allow create: if signedIn() && id == myId() && request.resource.data.key == get(/databases/$(database)/documents/config/biz).data.key;
      allow delete: if signedIn() && id == myId();
    }
    // Zähler für Passwort-Reset (Admin); lesbar vor dem Login
    match /gens/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /members/{id} {
      allow read: if isMember() || (signedIn() && id == myId());
      allow create: if signedIn() && id == myId() && (
        (exists(/databases/$(database)/documents/reg/$(id)) && (request.resource.data.role == 'staff' || id in admins()))
        || (id == 'admin-adminski' && !exists(/databases/$(database)/documents/config/main)));
      allow update: if isAdmin() || (signedIn() && id == myId() && (
        (request.resource.data.role == resource.data.role
        || request.resource.data.role == 'staff'
        || id in admins())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pos','noAvail','noSwap','noOff'])));
      allow delete: if isAdmin() || (signedIn() && id == myId());
    }

    function onlyKeys(ks) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ks); }
    // Dienstplan: nur Admins schreiben; Mitarbeiter dürfen nur Tausch anfragen / angebotene Schicht übernehmen
    match /plan/{pid} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isMember() && resource.data.uid == myId() && onlyKeys(['swapBy','swapById']))
        || (isMember() && resource.data.swapBy is string && resource.data.swapBy != '' && request.resource.data.uid == myId() && onlyKeys(['uid','name','swapBy','swapById','note']));
    }
    // Frei-Wünsche: Mitarbeiter stellen nur eigene, nur "pending"; Entscheidung nur Admin
    match /offs/{oid} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.uid == myId() && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isMember() && resource.data.uid == myId());
    }
    // Verfügbarkeit: jeder nur eigene Einträge
    match /avail/{vid} {
      allow read: if isMember();
      allow create: if isMember() && (request.resource.data.uid == myId() || isAdmin());
      allow update: if isAdmin() || (isMember() && resource.data.uid == myId() && request.resource.data.uid == myId());
      allow delete: if isAdmin() || (isMember() && resource.data.uid == myId());
    }
    match /shifts/{sid} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == myId());
      allow create: if isMember() && request.resource.data.uid == myId();
      allow update: if isAdmin() || (isMember() && resource.data.uid == myId() && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }
    match /audit/{aid} {
      allow read: if isAdmin();
      allow create: if isMember();
    }
    // Wiederherstellungs-Anfragen darf auch ein (gelöschtes) Konto stellen
    match /requests/{rid} {
      allow get: if isMember() || (signedIn() && resource.data.uid == myId());
      allow list: if isMember();
      allow create: if isMember() || (signedIn() && request.resource.data.uid == myId() && request.resource.data.type == 'restore');
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == myId());
    }
    // Schnorki-Verlauf: jeder schreibt nur seinen eigenen, lesen darf nur der Entwickler
    match /aihist/{uid} {
      allow read: if isDev();
      allow write: if isMember() && uid == myId();
    }
    match /layout/{lid} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /{coll}/{docId} {
      allow read, write: if isMember() && coll in ['notes','tasks','reports','recipes','rgroups','rules','checklists','checks','stock','tdev','temps','devmsgs','handover','repairs','feedback','orders','events','ideas','absence'];
    }
    match /{coll}/{docId} {
      allow read: if isMember() && coll in ['offers','contacts','news','onboard','emerg'];
      allow write: if isAdmin() && coll in ['offers','contacts','news','onboard','emerg'];
    }
  }
}
